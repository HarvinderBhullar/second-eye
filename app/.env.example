# OpenAI-compatible vLLM server (include /v1)
VLLM_BASE_URL=http://10.0.0.5:8000/v1
# Optional; sent as "Authorization: Bearer <key>" (matches `vllm serve --api-key`)
VLLM_API_KEY=
# Exact id from GET /v1/models (the --served-model-name, or the HF repo id)
VLLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-BF16
VLLM_TIMEOUT=90

# Optional second reader (clm-serve). Leave empty to hide the Two readers panel.
CLM_URL=
CLM_MODEL=fracatlas-medsiglip

# Optional one-click examples: "Label=path;Label=path"
DEMO_IMAGES=

# Optional display-only chips under the X-ray viewer
ENCODER_LABEL=MedSigLIP-448, frozen
HEAD_LABEL=CLM state head, Platt-calibrated
SERVED_ON=Nebius GPU

# 1 = canned, clearly labelled fake VLM reply (no GPU needed)
MOCK_VLLM=0
# 1 = CLM_URL points at a stand-in (tests/fake_clm.py); the UI then labels CLM numbers as not real
MOCK_CLM=0
